{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "local-paths",
      "hidden": true,
      "description": "Machine-specific paths. Adjust these values and save the file as CMakeUserPresets.json.",
      "cacheVariables": {
        "Qt5_DIR": "D:/Qt/Qt5.14.2/5.14.2/msvc2017_64/lib/cmake/Qt5",
        "OpenCV_DIR": "D:/OpenCV/opencv/build",
        "SPINNAKER_DIR": "D:/Program Files/Teledyne/Spinnaker",
        "SMCP_WITH_SPINNAKER": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug (x64)",
      "inherits": [ "ninja-debug-base", "local-paths" ]
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release (x64)",
      "inherits": [ "ninja-release-base", "local-paths" ]
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (solution in build/vs2026)",
      "inherits": [ "vs2026-base", "local-paths" ]
    }
  ],
  "buildPresets": [
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" }
  ]
}
