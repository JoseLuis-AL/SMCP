          <widget class="QLabel" name="homography_window_label">
           <property name="toolTip">
            <string>Side of the square window around each chessboard corner, in camera pixels, whose decoded pixels locate the corner in the projector</string>
           </property>
           <property name="text">
            <string>Corner window (px)</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="homography_window_spin"/>
         </item>
         <item row="1" column="0" colspan="2">
          <widget class="QCheckBox" name="joint_refinement_check">
           <property name="toolTip">
            <string>Refine the camera, the projector and their relative pose together in the last step of the calibration. Unchecked: the classic method, which keeps the camera and projector as calibrated separately. It applies to the next calibration</string>
           </property>
           <property name="text">
            <string>Joint refinement</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0" colspan="2">
          <widget class="QCheckBox" name="subpixel_corners_check">
           <property name="toolTip">
            <string>Locate the chessboard corners in the projector with sub-pixel projector coordinates instead of whole projector pixels. The images of every set are read once more. It applies to the next calibration</string>
           </property>
           <property name="text">
            <string>Sub-pixel corners</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="reconstruction_group">
        <property name="minimumSize">
         <size>
          <width>260</width>
          <height>0</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>260</width>
          <height>16777215</height>
         </size>
        </property>
        <property name="title">
         <string>Reconstruction</string>
        </property>
        <layout class="QFormLayout" name="formLayout_5">
         <property name="horizontalSpacing">
          <number>6</number>
         </property>
         <property name="verticalSpacing">
          <number>6</number>
         </property>
         <property name="leftMargin">
          <number>6</number>
         </property>
         <property name="topMargin">
          <number>6</number>
         </property>
         <property name="rightMargin">
          <number>6</number>
         </property>
         <property name="bottomMargin">
          <number>6</number>
         </property>
         <item row="0" column="0">
          <widget class="QLabel" name="max_dist_label">
           <property name="toolTip">
            <string>A point is kept only when its camera ray and projector ray pass closer than this distance, in millimetres</string>
           </property>
           <property name="text">
            <string>Max. ray distance (mm)</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="max_dist_line">
           <property name="text">
            <string>0.0</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QCheckBox" name="normals_check">
           <property name="toolTip">
            <string>Write a normal per point when exporting PLY (XYZ files have no normals)</string>
           </property>
           <property name="text">
            <string>Export normals (PLY)</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QCheckBox" name="colors_check">
           <property name="toolTip">
            <string>Write the color of each point when exporting XYZ or PLY</string>
           </property>
           <property name="text">
            <string>Export colors</string>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QCheckBox" name="compensation_check">
           <property name="toolTip">
            <string>Correct every reconstruction with the compensation model chosen with the button beside</string>
           </property>
           <property name="text">
            <string>Compensate</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QToolButton" name="compensation_button">
           <property name="toolTip">
            <string>Choose the compensation model (.json) trained by the pinn-smcp trainer</string>
           </property>
           <property name="text">
            <string>Model...</string>
           </property>
          </widget>
         </item>
         <item row="4" column="0" colspan="2">
          <widget class="QCheckBox" name="subpixel_check">
           <property name="toolTip">
            <string>Reconstruct one point per camera pixel, locating the stripe borders between pixels: a denser cloud with less noise. Unchecked: the classic method, one point per projector pixel. Reconstruct from Dump always uses the classic method</string>
           </property>
           <property name="text">
            <string>Sub-pixel (camera resolution)</string>
           </property>
          </widget>
         </item>
         <item row="5" column="0" colspan="2">
          <widget class="QCheckBox" name="plane_triangulation_check">
           <property name="toolTip">
            <string>Compute each point where the camera ray meets the plane of light of its projector column, so the projector row does not affect the point. Unchecked: the classic method, the midpoint between the camera ray and the projector ray</string>
           </property>
           <property name="text">
            <string>Projector-plane triangulation</string>
           </property>
          </widget>
         </item>
         <item row="6" column="0">
          <spacer name="verticalSpacer">
           <property name="orientation">
            <enum>Qt::Vertical</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>20</width>
             <height>40</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
