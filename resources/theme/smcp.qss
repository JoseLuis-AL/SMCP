/* =============================================================================
   SMCP - application-wide visual theme
   Loaded once by smcp::Application::ApplyTheme() on top of the "Fusion" style.
   The application font (Segoe UI 9pt) is set with QApplication::setFont. Forms
   do not set their own styleSheet or font; the only runtime exceptions are
   documented in docs/STYLE.md.

   TOKENS (reference only; QSS has no variables, so values are repeated as-is)
   ----------------------------------------------------------------------------
   Colors
     base         #f0f0f0                  window, dialog, and group backgrounds
     surface      #ffffff                  view, list, and field backgrounds
     border       #d1d1d1                  group borders and separators
     border-soft  #dcdcdc                  view, field, and progress borders
     hover        rgba(199, 199, 199, 0.4) hovered view selector button
     active       #c7c7c7                  pressed or checked view selector button
     accent       #3e8948                  progress bar and projector alignment
                                           cross (ProjectorWidget)
     overlay      rgba(20, 20, 20, 180)    point-cloud list over the 3D viewport
     visibility   #00529d                  point-cloud visibility button
     delete       #e43b44                  point-cloud delete button
   Typography
     family       Segoe UI                 (Application.cpp, QApplication::setFont)
     base         9pt                      controls, labels, and menus
     group        10pt bold                QGroupBox titles
     dialog       10pt                     About dialog labels
     subtitle     11pt                     AboutDialog#course_label
     title        16pt                     AboutDialog#title_label
     ai-title     12pt bold                AiInferenceProgressDialog#title_label
   Geometry
     radius       4px                      groups, views, fields, view buttons
     group title  padding 0 10px, margin-top 5px; groups reserve margin-top 20px
   Spacing (defined in the .ui files, not here)
     dialog       9px margins, 6px spacing (root layout of each QDialog)
     group        6px margins, 6px spacing (nested layouts)
   ============================================================================= */

/* --- Base surfaces -------------------------------------------------------- */
QMainWindow,
QDialog,
QGroupBox {
    background-color: #f0f0f0;
}

/* --- Groups --------------------------------------------------------------- */
QGroupBox {
    border: 0px solid #d1d1d1;
    border-radius: 4px;
    margin-top: 20px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    font-size: 10pt;
    font-weight: bold;
    padding: 0 10px;
    margin-top: 5px;
}

/* Parameter groups in the right panel (MainWindow): top separator only. */
QGroupBox#checkerboard_group,
QGroupBox#robust_decode_group,
QGroupBox#calibration_group,
QGroupBox#reconstruction_group {
    border-top: 1px solid #d1d1d1;
}

/* Projector and camera groups (CaptureDialog): full border. */
QGroupBox#projector_group,
QGroupBox#camera_group {
    border: 1px solid #d1d1d1;
}

/* --- Views and fields ----------------------------------------------------- */
QTreeView,
QListView,
QTableView,
QTextEdit,
QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 4px;
}

QTreeView#image_tree {
    padding-top: 5px;
}

QTreeView::corner,
QTableView::corner {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
}

/* --- View selector (MainWindow): flat buttons with state ------------------ */
/* Only the QToolButtons in the "Current View" group; action buttons keep the
   regular Fusion appearance. */
QGroupBox#current_image_group QToolButton {
    border: none;
    border-radius: 4px;
    background: transparent;
}

QGroupBox#current_image_group QToolButton:hover {
    background: rgba(199, 199, 199, 0.4);
}

QGroupBox#current_image_group QToolButton:checked,
QGroupBox#current_image_group QToolButton:pressed {
    background: #c7c7c7;
}

/* Point-cloud overlay list: translucent dark panel over the black 3D viewport. */
QListWidget#pointcloud_overlay_list {
    background: rgba(20, 20, 20, 180);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 6px;
    outline: none;
}

QListWidget#pointcloud_overlay_list::item {
    padding: 2px 0px;
    border: none;
}

QListWidget#pointcloud_overlay_list::item:selected {
    background: rgba(255, 255, 255, 25);
}

QListWidget#pointcloud_overlay_list::item:hover {
    background: rgba(255, 255, 255, 15);
}

QLabel#pointcloud_overlay_label {
    color: #ffffff;
    background: transparent;
}

QLineEdit#pointcloud_overlay_name {
    color: #ffffff;
    background: transparent;
    border: 1px solid transparent;
    padding: 1px 2px;
}

QLineEdit#pointcloud_overlay_name:focus {
    background: rgba(255, 255, 255, 20);
    border: 1px solid rgba(255, 255, 255, 90);
    border-radius: 2px;
}

QToolButton#pointcloud_overlay_visibility {
    background: #00529d;
    border: none;
    border-radius: 3px;
    padding: 0px;
}

QToolButton#pointcloud_overlay_visibility:hover {
    background: #0068c7;
}

QToolButton#pointcloud_overlay_visibility:pressed {
    background: #003f79;
}

QToolButton#pointcloud_overlay_delete {
    background: #e43b44;
    border: none;
    border-radius: 3px;
    padding: 0px;
}

QToolButton#pointcloud_overlay_delete:hover {
    background: #ee5059;
}

QToolButton#pointcloud_overlay_delete:pressed {
    background: #c92f38;
}

/* --- Progress ------------------------------------------------------------- */
QProgressBar {
    background: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3e8948;
    border-radius: 3px;
}

/* "Thinking..." window shown during AI inference. */
QDialog#AiInferenceProgressDialog QLabel#title_label {
    font-size: 12pt;
    font-weight: bold;
}

/* --- About dialog --------------------------------------------------------- */
QDialog#AboutDialog QLabel {
    font-size: 10pt;
}

QDialog#AboutDialog QLabel#course_label {
    font-size: 11pt;
}

QDialog#AboutDialog QLabel#title_label {
    font-size: 16pt;
}
