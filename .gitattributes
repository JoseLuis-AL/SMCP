# Normalize line endings: LF in the repository and in working copies.
* text=auto eol=lf

# C++ sources and Qt files are text.
*.cpp text
*.h   text
*.hpp text
*.ui  text
*.qrc text
*.qss text
*.svg text

# Visual Studio files keep CRLF if they are ever generated and committed.
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.vcxproj.filters text eol=crlf

# Windows scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.pdf  binary
