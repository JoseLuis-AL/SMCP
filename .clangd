# clangd configuration for the project (Zed and any other LSP editor).
# CMake generates the compilation database with the ninja-debug preset.
CompileFlags:
  CompilationDatabase: build/ninja-debug
  # With cl.exe in compile_commands.json, clangd runs in clang-cl mode and finds the
  # installed MSVC toolset and Windows SDK by itself (no --query-driver needed).
  # Options that clang-cl does not understand are removed.
  Remove:
    - /MP
    - -MP
    - /Zc:__cplusplus*
  Add:
    - -Wno-unknown-argument
    - -Wno-unused-command-line-argument
    - -Wno-microsoft-include
    - -ferror-limit=0

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - attributes_misplaced   # __declspec placement in Spinnaker SDK headers that clang rejects
